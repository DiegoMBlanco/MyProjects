<?xml version="1.0"?>
<robot name="f1tenth" xmlns:xacro="http://ros.org/wiki/xacro"> 
  <xacro:property name="package_name" value="f1tenth_simulation"/>
  <xacro:property name="PI" value="3.14159265"/>

  <xacro:arg name="base_color"    default="0.0 1.0 0.0 1.0"/>
  <xacro:arg name="ns" default="r1"/>
  
  <material name="gray">
    <color rgba="0.4 0.4 0.4 1.0"/>
  </material>

  <material name="black">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>

  <material name="red">
    <color rgba="0.5 0.0 0.0 1.0"/>
  </material>

  <link name="$(arg ns)/base_footprint"/>


  <joint name="$(arg ns)/base1_joint" type="fixed">
    <parent link="$(arg ns)/base_footprint"/>
    <child link="$(arg ns)/base1_link"/>
    <origin xyz="0 0 0.05" rpy = "0 0 0"/> 0
    <axis xyz="0 0 0"/>
  </joint>

  <link name="$(arg ns)/base1_link">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/> 0
      <geometry>
        <mesh filename = "package://${package_name}/meshes/base_abajo_f1tenth.stl" scale="0.01 0.01 0.01"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <origin xyz="-0.003 0 0.0025" rpy="0 0 0"/>
      <geometry>
        <box size="0.40 0.14 0.005"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="3"/>
      <inertia ixx="0.02723" ixy="0.0" ixz="0.0"  iyy="0.03212" iyz="0.0"  izz="0.0049" />
    </inertial>
  </link>

  <joint name="$(arg ns)/base2_joint" type="fixed">
    <parent link="$(arg ns)/base1_link"/>
    <child link="$(arg ns)/base2_link"/>
    <origin xyz="0.025 0 0.105" rpy = "0 0 0"/> 0
    <axis xyz="0 0 0"/>
  </joint>

  <link name="$(arg ns)/base2_link">
    <visual>
      <origin xyz="0 0.0 0.0" rpy="0 0 0"/> 0
      <geometry>
        <mesh filename = "package://${package_name}/meshes/base_arriba_f1tenth.stl" scale="0.01 0.01 0.01"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <origin xyz="0.0 0 0.0025" rpy="0 0 0"/>
      <geometry>
        <box size="0.33 0.14 0.005"/>
      </geometry>
    </collision>
  </link>

  <joint name="$(arg ns)/standoff1_joint" type="fixed">
    <parent link="$(arg ns)/base1_link"/>
    <child link="$(arg ns)/standoff1_link"/>
    <origin xyz="0.05 0.06 0.0575" rpy = "0 0 0"/> 0
    <axis xyz="0 0 0"/>
  </joint>

  <link name="$(arg ns)/standoff1_link">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/> 0
      <geometry>
        <cylinder length="0.105" radius="0.004"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <origin xyz="0.0 0 0.0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.105" radius="0.004"/>
      </geometry>
    </collision>
  </link>

  <joint name="$(arg ns)/standoff2_joint" type="fixed">
    <parent link="$(arg ns)/base1_link"/>
    <child link="$(arg ns)/standoff2_link"/>
    <origin xyz="0.05 -0.06 0.0575" rpy = "0 0 0"/> 0
    <axis xyz="0 0 0"/>
  </joint>

  <link name="$(arg ns)/standoff2_link">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/> 0
      <geometry>
        <cylinder length="0.105" radius="0.004"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <origin xyz="0.0 0 0.0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.105" radius="0.004"/>
      </geometry>
    </collision>
  </link>

  <joint name="$(arg ns)/standoff3_joint" type="fixed">
    <parent link="$(arg ns)/base1_link"/>
    <child link="$(arg ns)/standoff3_link"/>
    <origin xyz="-0.08 0.06 0.0575" rpy = "0 0 0"/> 0
    <axis xyz="0 0 0"/>
  </joint>

  <link name="$(arg ns)/standoff3_link">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/> 0
      <geometry>
        <cylinder length="0.105" radius="0.004"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <origin xyz="0.0 0 0.0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.105" radius="0.004"/>
      </geometry>
    </collision>
  </link>

  <joint name="$(arg ns)/standoff4_joint" type="fixed">
    <parent link="$(arg ns)/base1_link"/>
    <child link="$(arg ns)/standoff4_link"/>
    <origin xyz="-0.08 -0.06 0.0575" rpy = "0 0 0"/> 0
    <axis xyz="0 0 0"/>
  </joint>

  <link name="$(arg ns)/standoff4_link">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/> 0
      <geometry>
        <cylinder length="0.105" radius="0.004"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <origin xyz="0.0 0 0.0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.105" radius="0.004"/>
      </geometry>
    </collision>
  </link>

  <joint name="$(arg ns)/front_base_wheel_joint" type="fixed">
    <parent link="$(arg ns)/base1_link"/>
    <child link="$(arg ns)/front_base_wheel_link"/>
    <origin xyz="0.12 0 0.026" rpy = "${PI/2} 0 ${PI/2}"/> 0
    <axis xyz="0 0 0"/>
  </joint>

  <link name="$(arg ns)/front_base_wheel_link">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/> 0
      <geometry>
        <mesh filename = "package://${package_name}/meshes/base_ruedas_f1tenth.stl" scale="0.01 0.01 0.01"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.015" rpy="0 0 0"/>
      <geometry>
        <box size="0.15 0.03 0.03"/>
      </geometry>
    </collision>
  </link>

  <joint name="$(arg ns)/rear_base_wheel_joint" type="fixed">
    <parent link="$(arg ns)/base1_link"/>
    <child link="$(arg ns)/rear_base_wheel_link"/>
    <origin xyz="-0.21 0 0.026" rpy = "${PI/2} 0 ${PI/2}"/> 
    <axis xyz="0 0 0"/>
  </joint>

  <link name="$(arg ns)/rear_base_wheel_link">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/> 0
      <geometry>
        <mesh filename = "package://${package_name}/meshes/base_ruedas_f1tenth.stl" scale="0.01 0.01 0.01"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <origin xyz="0.0 0 0.015" rpy="0 0 0"/>
      <geometry>
        <box size="0.15 0.03 0.03"/>
      </geometry>
    </collision>
  </link>

  <!-- Ruedas traseras -->

  <joint name="$(arg ns)/rear_left_wheel_joint" type="continuous">
    <parent link="$(arg ns)/base1_link"/>
    <child link="$(arg ns)/rear_left_wheel_link"/>
    <origin xyz="-0.196 0.1455 0.0125" rpy="${PI/2} 0 0"/>
    <axis xyz="0 0 -1"/>
  </joint>

  <link name="$(arg ns)/rear_left_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
          <mesh filename = "package://${package_name}/meshes/ruedas_f1tenth.stl" scale="0.01 0.01 0.01"/>
      </geometry>
      <material name="black"/>
    </visual>
      <collision>
        <origin xyz="0 0 0.024" rpy="0 0 0"/>
        <geometry>
          <cylinder length="0.048" radius="0.0575"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0"/>
        <mass value="0.1"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.00016"/>
      </inertial>
  </link>

  <joint name="$(arg ns)/rear_right_wheel_joint" type="continuous">
    <parent link="$(arg ns)/base1_link"/>
    <child link="$(arg ns)/rear_right_wheel_link"/>
    <origin xyz="-0.196 -0.1015 0.0125" rpy="${PI/2} 0 0"/>
    <axis xyz="0 0 -1"/>
  </joint>

  <link name="$(arg ns)/rear_right_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
          <mesh filename = "package://${package_name}/meshes/ruedas_f1tenth.stl" scale="0.01 0.01 0.01"/>
      </geometry>
      <material name="black"/>
    </visual>
      <collision>
        <origin xyz="0 0 0.024" rpy="0 0 0"/>
        <geometry>
          <cylinder length="0.048" radius="0.0575"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0"/>
        <mass value="0.1"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.00016"/>
      </inertial>
  </link>


  <!-- Eslabones de dirección delanteros -->

  <joint name="$(arg ns)/front_left_wheel_steering_joint" type="revolute">
      <parent link="$(arg ns)/base1_link"/>
      <child link="$(arg ns)/front_left_wheel_steering"/>
      <origin xyz="0.134 0.093 0.015" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-0.8" upper="0.8" effort="50" velocity="1.0"/>
  </joint>

  <link name="$(arg ns)/front_left_wheel_steering">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.01" radius="0.01"/>
      </geometry>
      <material name="black"/>
    </visual>
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.0153" ixy="0.0" ixz="0.0" iyy="0.025" iyz="0.0" izz="0.0153"/>
    </inertial>
  </link>

  <joint name="$(arg ns)/front_right_wheel_steering_joint" type="revolute">
      <parent link="$(arg ns)/base1_link"/>
      <child link="$(arg ns)/front_right_wheel_steering"/>
      <origin xyz="0.134 -0.093 0.015" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-0.8" upper="0.8" effort="50" velocity="1.0"/>
  </joint>

  <link name="$(arg ns)/front_right_wheel_steering">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.01" radius="0.01"/>
      </geometry>
      <material name="black"/>
    </visual>
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.0153" ixy="0.0" ixz="0.0" iyy="0.025" iyz="0.0" izz="0.0153"/>
    </inertial>
  </link>

  <!-- Ruedas delanteras -->

  <joint name="$(arg ns)/front_left_wheel_joint" type="continuous">
    <parent link="$(arg ns)/front_left_wheel_steering"/>
    <child link="$(arg ns)/front_left_wheel_link"/>
    <origin xyz="0 0.052 0.0" rpy="${PI/2} 0 0"/> <!--0.134 0.1455 0.0125-->
    <axis xyz="0 0 -1"/>
  </joint>

  <link name="$(arg ns)/front_left_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
          <mesh filename = "package://${package_name}/meshes/ruedas_f1tenth.stl" scale="0.01 0.01 0.01"/>
      </geometry>
      <material name="black"/>
    </visual>
      <collision>
        <origin xyz="0 0 0.024" rpy="0 0 0"/>
        <geometry>
          <cylinder length="0.048" radius="0.0575"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0"/>
        <mass value="0.1"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.00016"/>
      </inertial>
  </link>

  <joint name="$(arg ns)/front_right_wheel_joint" type="continuous">
    <parent link="$(arg ns)/front_right_wheel_steering"/>
    <child link="$(arg ns)/front_right_wheel_link"/>
    <origin xyz="0 -0.009 0.0" rpy="${PI/2} 0 0"/>
    <axis xyz="0 0 -1"/>
  </joint>

  <link name="$(arg ns)/front_right_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
          <mesh filename = "package://${package_name}/meshes/ruedas_f1tenth.stl" scale="0.01 0.01 0.01"/>
      </geometry>
      <material name="black"/>
    </visual>
      <collision>
        <origin xyz="0 0 0.024" rpy="0 0 0"/>
        <geometry>
          <cylinder length="0.048" radius="0.0575"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0"/>
        <mass value="0.1"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.00016"/>
      </inertial>
  </link>

  <joint name="$(arg ns)/camera_base_joint" type="fixed">
    <parent link="$(arg ns)/base1_link"/>
    <child link="$(arg ns)/camera_base_link"/>
    <origin xyz="0.21 0 0.005" rpy = "0 0 ${-PI/2}"/> 
    <axis xyz="0 0 0"/>
  </joint>

  <link name="$(arg ns)/camera_base_link">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/> 0
      <geometry>
        <mesh filename = "package://${package_name}/meshes/base_camara_f1tenth.stl" scale="0.01 0.01 0.01"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.18 0.06 0.005"/>
      </geometry>
    </collision>
  </link>


  <!-- LIDAR -->
  <joint name="$(arg ns)/hokuyo_joint" type="fixed">
    <parent link="$(arg ns)/base2_link"/>
    <child link="$(arg ns)/hokuyo_link" />
    <origin xyz="0.11 0 0.04" rpy="0 0 0"/>
    <axis xyz="0 0 1" />
  </joint>

  <link name="$(arg ns)/hokuyo_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://${package_name}/meshes/hokuyo.dae"/>
        <material name="black" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.07"/>
      </geometry>
    </collision>
  </link>


  <gazebo reference = "$(arg ns)/hokuyo_link">
    <sensor name='gpu_lidar' type='gpu_lidar'>
      <ignition_frame_id>$(arg ns)/hokuyo_link</ignition_frame_id>
      <update_rate>40</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>1081</samples>
            <resolution>1</resolution>
            <min_angle>-2.3561944902</min_angle>
            <max_angle>2.3561944902</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.1</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type> gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <alwaysOn>1</alwaysOn>
      <visualize>true</visualize>
      <topic>$(arg ns)/hokuyo</topic>
    </sensor>
  </gazebo>



  <!-- IMU -->
  <gazebo reference = "$(arg ns)/base_footprint">
    <sensor name = "imu_sensor" type="imu">
      <ignition_frame_id>$(arg ns)/base_footprint</ignition_frame_id>
      <always_on>1</always_on>
      <update_rate>50</update_rate>
      <visualize>false</visualize>
      <topic>$(arg ns)/imu</topic>
      <imu>
        <enable_orientation>0</enable_orientation>
        <angular_velocity>
          <x>
            <noise type = "gaussian">
              <mean>0</mean>
              <stddev>0.009</stddev>
              <bias_mean>0.00075</bias_mean>
              <bias_stddev>0.005</bias_stddev>
              <dynamic_bias_stddev>0.00002</dynamic_bias_stddev>
              <precision>0.00025</precision>
            </noise>
          </x>
          <y>
            <noise type = "gaussian">
              <mean>0</mean>
              <stddev>0.009</stddev>
              <bias_mean>0.00075</bias_mean>
              <bias_stddev>0.005</bias_stddev>
              <dynamic_bias_stddev>0.00002</dynamic_bias_stddev>
              <precision>0.00025</precision>
            </noise>
          </y>
          <z>
            <noise type = "gaussian">
              <mean>0</mean>
              <stddev>0.009</stddev>
              <bias_mean>0.00075</bias_mean>
              <bias_stddev>0.005</bias_stddev>
              <dynamic_bias_stddev>0.00002</dynamic_bias_stddev>
              <precision>0.00025</precision>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type = "gaussian">
              <mean>0</mean>
              <stddev>0.021</stddev>
              <bias_mean>0.05</bias_mean>
              <bias_stddev>0.0075</bias_stddev>
              <dynamic_bias_stddev>0.000375</dynamic_bias_stddev>
              <dynamic_bias_correlation_time>175.0</dynamic_bias_correlation_time>
              <precision>0.005</precision>
            </noise>
          </x>
          <y>
            <noise type = "gaussian">
              <mean>0</mean>
              <stddev>0.021</stddev>
              <bias_mean>0.05</bias_mean>
              <bias_stddev>0.0075</bias_stddev>
              <dynamic_bias_stddev>0.000375</dynamic_bias_stddev>
              <dynamic_bias_correlation_time>175.0</dynamic_bias_correlation_time>
              <precision>0.005</precision>
            </noise>
          </y>
          <z>
            <noise type = "gaussian">
              <mean>0</mean>
              <stddev>0.021</stddev>
              <bias_mean>0.05</bias_mean>
              <bias_stddev>0.0075</bias_stddev>
              <dynamic_bias_stddev>0.000375</dynamic_bias_stddev>
              <dynamic_bias_correlation_time>175.0</dynamic_bias_correlation_time>
              <precision>0.005</precision>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <!-- Camara ZED -->
  <joint name="$(arg ns)/zed_camera_joint" type="fixed">
    <parent link="$(arg ns)/camera_base_link"/>
    <child link="$(arg ns)/zed_camera_link"/>
    <origin xyz="0 0 0.02" rpy="0 0 ${PI/2}"/>
    <axis xyz="0 0 1" />
  </joint>

  <link name="$(arg ns)/zed_camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.033 0.175 0.030"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.033 0.175 0.030"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1e-5" />
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6" />
    </inertial>
  </link>

  <gazebo reference="$(arg ns)/zed_camera_link">
     <sensor name="rgbd_camera" type="rgbd_camera">
      <ignition_frame_id>$(arg ns)/zed_camera_link</ignition_frame_id>
      <camera name="zed_camera">
        <horizontal_fov>0.8709216071359963</horizontal_fov>
        <distortion>
          <k1>0.0</k1>
          <k2>0.0</k2>
          <k3>0.0</k3>
          <p1>0.0</p1>
          <p2>0.0</p2>
          <center>0.5 0.5</center>
        </distortion>
        <image>
          <width>640</width>
          <height>480</height>
          <format>B8G8R8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>300</far>
        </clip>
        <depth_camera>
          <clip>
            <near>0.1</near>
            <far>20</far>
          </clip>
        </depth_camera>
        <noise>
          <type>gaussian</type>
          <mean>0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
      <always_on>1</always_on>
      <update_rate>30</update_rate>
      <visualize>0</visualize>
      <topic>$(arg ns)/zed_camera</topic>
    </sensor>
  </gazebo>

  


  <!-- PULGINS -->

  <gazebo>
    <plugin
      filename="ignition-gazebo-ackermann-steering-system"
      name="gz::sim::systems::AckermannSteering">
      <left_joint>$(arg ns)/rear_left_wheel_joint</left_joint>
      <right_joint>$(arg ns)/rear_right_wheel_joint</right_joint>
      <left_steering_joint>$(arg ns)/front_left_wheel_steering_joint</left_steering_joint>
      <right_steering_joint>$(arg ns)/front_right_wheel_steering_joint</right_steering_joint>
      <kingpin_width>0.186</kingpin_width>
      <steering_limit>0.3</steering_limit>
      <wheel_base>0.33</wheel_base>
      <wheel_separation>0.247</wheel_separation>
      <wheel_radius>0.054</wheel_radius>
      <min_velocity>-10</min_velocity>
      <max_velocity>10</max_velocity>
      <min_acceleration>-10</min_acceleration>
      <max_acceleration>10</max_acceleration>
      <odom_frame>$(arg ns)/odom</odom_frame>  <!-- odometria con encoders -->  
      <robot_base_frame>$(arg ns)/base_footprint</robot_base_frame>  
      <publish_odom_tf>true</publish_odom_tf >
    </plugin>


    <plugin
      filename="gz-sim-joint-state-publisher-system"
      name = "gz::sim::systems::JointStatePublisher">
    </plugin>

  </gazebo>


  

</robot>
<?xml version="1.0"?>
<robot name="puzzlebot" xmlns:xacro="http://ros.org/wiki/xacro"> 
  <xacro:property name="package_name" value="gemelo_digital_puzzlebot"/>
  <xacro:property name="PI" value="3.14159265"/>
  <xacro:property name="wheelSeparation" value="0.209"/> <!--0.17 (bien en simulación) | 0.207 (bien en gemelo)-->
  <xacro:property name="wheelDiameter" value="0.112"/>
  <xacro:property name="wheelThickness" value="0.008"/>
  <xacro:property name="base_elevation" value="0.025"/>

  <xacro:arg name="base_color"    default="0.0 1.0 0.0 1.0"/>
  <xacro:arg name="ns" default="r1"/>
  
  <material name="gray">
    <color rgba="0.4 0.4 0.4 0.5"/>
  </material>

  <material name="gray2">
    <color rgba="0.6 0.6 0.6 1.0"/>
  </material>
  <material name="gray3">
    <color rgba="0.3 0.3 0.3 1.0"/>
  </material>

  <material name="black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>

  <material name="golden">
    <color rgba="1.0 0.4 0.0 1.0"/>
  </material>

  <material name="red">
    <color rgba="1.0 0.0 0.0 1.0"/>
  </material>

  <link name="$(arg ns)/base_footprint"/>

  <!--joint name="$(arg ns)/base_chassis_joint" type="fixed">
    <parent link="$(arg ns)/base_footprint"/>
    <child link="$(arg ns)/chassis"/>
    <origin xyz="0 ${wheelSeparation/2} ${wheelDiameter/2-base_elevation}" rpy = "0 0 0"/>
    <axis xyz="0 0 0"/>
  </joint>

  <link name="$(arg ns)/chassis">
    <visual>
      <origin xyz="0.11 -0.095 0.050" rpy="${PI/2} 0 ${PI}"/>
      <geometry>
        <mesh filename = "package://${package_name}/meshes/Queza.STL" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.16 0.20 0.05"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz = "0 0 0"/>
      <mass value="5"/>
      <inertia ixx="0.333333" ixy="0.0" ixz="0.0"  iyy="0.333333" iyz="0.0"  izz="0.6"  />
    </inertial>
  </link-->

  <joint name="$(arg ns)/base1_joint" type="fixed">
    <parent link="$(arg ns)/base_footprint"/>
    <child link="$(arg ns)/base1_link"/>
    <origin xyz="0 0 ${wheelDiameter/2-base_elevation}" rpy = "0 0 0"/> <!--0 ${wheelSeparation/2} ${wheelDiameter/2-base_elevation}-->
    <axis xyz="0 0 0"/>
  </joint>

  <link name="$(arg ns)/base1_link">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 ${PI}"/>  <!--0.095 0.0815 0.0-->
      <geometry>
        <mesh filename = "package://${package_name}/meshes/base_puzzlebot.stl" scale="0.01 0.01 0.01"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <origin xyz="0.01 0 0.0025" rpy="0 0 ${PI/2}"/>
      <geometry>
        <box size="0.16 0.21 0.005"/>
      </geometry>
    </collision>
    <!-- Collision tag added to stabilize the robot >
    <collision> 
      <origin xyz="-0.07 0 -0.015" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.01" />
      </geometry>
    </collision-->
    <inertial>
      <origin xyz="-0.0550 0 0" rpy="0 0 0"/>
      <mass value="0.485"/>
      <inertia ixx="0.001881" ixy="0.0" ixz="0.0" iyy="0.001133" iyz="0.0" izz="0.002815" />
    </inertial>
  </link>

  <joint name="$(arg ns)/base2_joint" type="fixed">
      <parent link="$(arg ns)/base1_link"/>
      <child link="$(arg ns)/base2_link"/>
      <origin xyz="0 0 ${wheelDiameter/2-base_elevation + 0.020}" rpy = "0 0 0"/>
      <axis xyz="0 0 0"/>
    </joint>

    <link name="$(arg ns)/base2_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 ${PI}"/> <!--0.095 0.0815 0.045-->
        <geometry>
          <mesh filename = "package://${package_name}/meshes/base_puzzlebot.stl" scale="0.01 0.01 0.01"/>
        </geometry>
        <material name="gray"/>
      </visual>
      <collision>
        <origin xyz="0.01 0 0.0025" rpy="0 0 ${PI/2}"/>
        <geometry>
          <box size="0.16 0.21 0.005"/>
        </geometry>
      </collision>
    </link>

    <joint name="$(arg ns)/base3_joint" type="fixed">
      <parent link="$(arg ns)/base2_link"/>
      <child link="$(arg ns)/base3_link"/>
      <origin xyz="0 0 ${wheelDiameter/2-base_elevation + 0.020}" rpy = "0 0 0"/>
      <axis xyz="0 0 0"/>
    </joint>

    <link name="$(arg ns)/base3_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 ${PI}"/> <!--0.095 0.0815 0.045-->
        <geometry>
          <mesh filename = "package://${package_name}/meshes/base_puzzlebot.stl" scale="0.01 0.01 0.01"/>
        </geometry>
        <material name="gray"/>
      </visual>
      <collision>
        <origin xyz="0.01 0 0.0025" rpy="0 0 ${PI/2}"/>
        <geometry>
          <box size="0.16 0.21 0.005"/>
        </geometry>
      </collision>
    </link>

    <joint name="$(arg ns)/rubik_joint" type="fixed">
      <parent link="$(arg ns)/base2_link"/>
      <child link="$(arg ns)/rubik_link"/>
      <origin xyz="-0.05 0 0.005" rpy = "0 0 ${PI/2}"/>
      <axis xyz="0 0 0"/>
    </joint>

    <link name="$(arg ns)/rubik_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/> 
        <geometry>
          <mesh filename = "package://${package_name}/meshes/rubik.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.1 0.07 0.002"/>
        </geometry>
      </collision>
    </link>

    <joint name="$(arg ns)/battery_joint" type="fixed">
      <parent link="$(arg ns)/base1_link"/>
      <child link="$(arg ns)/battery_link"/>
      <origin xyz="0.05 0 0.0145" rpy = "0 0 0"/>
      <axis xyz="0 0 0"/>
    </joint>

    <link name="$(arg ns)/battery_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/> 
        <geometry>
          <box size="0.15 0.07 0.02"/>
        </geometry>
        <material name="gray2"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.15 0.07 0.02"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="1.0"/>
        <inertia ixx="0.000442" ixy="0.0" ixz="0.0" iyy="0.001908" iyz="0.0" izz="0.002283" />
      </inertial>
    </link>

  <joint name="$(arg ns)/standoff_joint_1" type="fixed">
    <parent link="$(arg ns)/base1_link"/>
    <child link="$(arg ns)/standoff1_link"/>
    <origin xyz="0.05 0.04 ${wheelDiameter/2-base_elevation}" rpy = "0 0 0"/>
    <axis xyz="0 0 0"/>
  </joint>

  <link name="$(arg ns)/standoff1_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/> <!--0.05 0.04 0.025-->
      <geometry>
        <cylinder length="0.04" radius="0.002"/>
      </geometry>
      <material name="golden"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.04" radius="0.002"/>
      </geometry>
    </collision>
  </link>

  <joint name="$(arg ns)/standoff_joint_2" type="fixed">
    <parent link="$(arg ns)/base1_link"/>
    <child link="$(arg ns)/standoff2_link"/>
    <origin xyz="0.05 -0.037 ${wheelDiameter/2-base_elevation}" rpy = "0 0 0"/>
    <axis xyz="0 0 0"/>
  </joint>

  <link name="$(arg ns)/standoff2_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/> <!--0.05 -0.037 0.025-->
      <geometry>
        <cylinder length="0.04" radius="0.002"/>
      </geometry>
      <material name="golden"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.04" radius="0.002"/>
      </geometry>
    </collision>
  </link>

  <joint name="$(arg ns)/standoff_joint_3" type="fixed">
    <parent link="$(arg ns)/base1_link"/>
    <child link="$(arg ns)/standoff3_link"/>
    <origin xyz="-0.08 -0.067  ${wheelDiameter/2-base_elevation}" rpy = "0 0 0"/>
    <axis xyz="0 0 0"/>
  </joint>

  <link name="$(arg ns)/standoff3_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/> <!---0.09 -0.067 0.025-->
      <geometry>
        <cylinder length="0.04" radius="0.002"/>
      </geometry>
      <material name="golden"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.04" radius="0.002"/>
      </geometry>
    </collision>
  </link>

  <joint name="$(arg ns)/standoff_joint_4" type="fixed">
    <parent link="$(arg ns)/base1_link"/>
    <child link="$(arg ns)/standoff4_link"/>
    <origin xyz="-0.08 0.067 ${wheelDiameter/2-base_elevation}" rpy = "0 0 0"/>
    <axis xyz="0 0 0"/>
  </joint>

  <link name="$(arg ns)/standoff4_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/> <!---0.09 0.07 0.025-->
      <geometry>
        <cylinder length="0.04" radius="0.002"/>
      </geometry>
      <material name="golden"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.04" radius="0.002"/>
      </geometry>
    </collision>
  </link>

  <!-- Standoffs segundo piso -->
  <joint name="$(arg ns)/standoff_joint_5" type="fixed">
    <parent link="$(arg ns)/base2_link"/>
    <child link="$(arg ns)/standoff5_link"/>
    <origin xyz="0.05 0.04 ${wheelDiameter/2-base_elevation}" rpy = "0 0 0"/>
    <axis xyz="0 0 0"/>
  </joint>

  <link name="$(arg ns)/standoff5_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/> <!--0.05 0.04 0.025-->
      <geometry>
        <cylinder length="0.04" radius="0.002"/>
      </geometry>
      <material name="golden"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.04" radius="0.002"/>
      </geometry>
    </collision>
  </link>

  <joint name="$(arg ns)/standoff_joint_6" type="fixed">
    <parent link="$(arg ns)/base2_link"/>
    <child link="$(arg ns)/standoff6_link"/>
    <origin xyz="0.05 -0.037 ${wheelDiameter/2-base_elevation}" rpy = "0 0 0"/>
    <axis xyz="0 0 0"/>
  </joint>

  <link name="$(arg ns)/standoff6_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/> <!--0.05 -0.037 0.025-->
      <geometry>
        <cylinder length="0.04" radius="0.002"/>
      </geometry>
      <material name="golden"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.04" radius="0.002"/>
      </geometry>
    </collision>
  </link>

  <joint name="$(arg ns)/standoff_joint_7" type="fixed">
    <parent link="$(arg ns)/base2_link"/>
    <child link="$(arg ns)/standoff7_link"/>
    <origin xyz="-0.08 -0.067  ${wheelDiameter/2-base_elevation}" rpy = "0 0 0"/>
    <axis xyz="0 0 0"/>
  </joint>

  <link name="$(arg ns)/standoff7_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/> <!---0.09 -0.067 0.025-->
      <geometry>
        <cylinder length="0.04" radius="0.002"/>
      </geometry>
      <material name="golden"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.04" radius="0.002"/>
      </geometry>
    </collision>
  </link>

  <joint name="$(arg ns)/standoff_joint_8" type="fixed">
    <parent link="$(arg ns)/base2_link"/>
    <child link="$(arg ns)/standoff8_link"/>
    <origin xyz="-0.08 0.067 ${wheelDiameter/2-base_elevation}" rpy = "0 0 0"/>
    <axis xyz="0 0 0"/>
  </joint>

  <link name="$(arg ns)/standoff8_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/> <!---0.09 0.07 0.025-->
      <geometry>
        <cylinder length="0.04" radius="0.002"/>
      </geometry>
      <material name="golden"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.04" radius="0.002"/>
      </geometry>
    </collision>
  </link>


  <joint name="$(arg ns)/base_panel_right_wheel_joint" type="fixed">
    <parent link="$(arg ns)/base1_link"/>
    <child link="$(arg ns)/right_panel_link"/>
    <origin xyz="-0.0550 0.073 ${wheelDiameter/2-base_elevation}" rpy = "0 0 0"/>
    <axis xyz="0 0 0"/>
  </joint>

  <link name="$(arg ns)/right_panel_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/> <!---0.0650 0.076 0.025-->
      <geometry>
        <box size="0.025 0.005 0.04"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.005 0.04"/>
      </geometry>
    </collision>
  </link>

  <joint name="$(arg ns)/base_panel_left_wheel_joint" type="fixed">
    <parent link="$(arg ns)/base1_link"/>
    <child link="$(arg ns)/left_panel_link"/>
    <origin xyz="-0.0550 -0.073 ${wheelDiameter/2-base_elevation}" rpy = "0 0 0"/>
    <axis xyz="0 0 0"/>
  </joint>

  <link name="$(arg ns)/left_panel_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/> <!---0.0650 -0.073 0.025-->
      <geometry>
        <box size="0.025 0.005 0.04"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.005 0.04"/>
      </geometry>
    </collision>
  </link>

  <joint name="$(arg ns)/cylinder_wheel_right_joint" type="fixed">
    <parent link="$(arg ns)/right_panel_link"/>
    <child link="$(arg ns)/cylinder_wheel_right_link"/>
    <origin xyz="0 0.004 0" rpy = "0 0 0"/>
    <axis xyz="0 0 0"/>
  </joint>

  <link name="$(arg ns)/cylinder_wheel_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="${PI/2} 0 0"/> <!---0.0650 0.086 0.025-->
      <geometry>
        <cylinder length="0.015" radius="0.0075"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
      <geometry>
        <cylinder length="0.015" radius="0.0075"/>
      </geometry>
    </collision>
  </link>

  <joint name="$(arg ns)/cylinder_wheel_left_joint" type="fixed">
    <parent link="$(arg ns)/left_panel_link"/>
    <child link="$(arg ns)/cylinder_wheel_left_link"/>
    <origin xyz="0 -0.004 0" rpy = "0 0 0"/>
    <axis xyz="0 0 0"/>
  </joint>

  <link name="$(arg ns)/cylinder_wheel_left_link">
    <visual>
      <origin xyz="0 0 0" rpy="${-PI/2} 0 0"/>
      <geometry>
        <cylinder length="0.015" radius="0.0075"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="${-PI/2} 0 0"/>
      <geometry>
        <cylinder length="0.015" radius="0.0075"/>
      </geometry>
    </collision>
  </link>

  <joint name="$(arg ns)/wheel_right_joint" type="continuous">
    <parent link="$(arg ns)/cylinder_wheel_right_link"/>
    <child link="$(arg ns)/wheel_right_link"/>
    <origin xyz="0 0.0155 0" rpy = "0 0 0"/>
    <axis xyz="0 -1 0"/>
  </joint>

  <link name="$(arg ns)/wheel_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="${PI/2} 0 0"/> <!---0.065 0.1015 0.025-->
      <geometry>
        <mesh filename = "package://${package_name}/meshes/rueda_puzzlebot.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 -0.005 0" rpy="${PI/2} 0 0"/>
      <geometry>
        <cylinder length="0.008" radius="0.056"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.056" />
      <inertia ixx="0.000035" ixy="0.0" ixz="0.0" iyy="0.00007" iyz="0.0" izz="0.000035" />
    </inertial>
  </link>

  <joint name="$(arg ns)/wheel_left_joint" type="continuous">
    <parent link="$(arg ns)/cylinder_wheel_left_link"/>
    <child link="$(arg ns)/wheel_left_link"/>
    <origin xyz="0.0 -0.0075 0" rpy = "0 0 0"/>
    <axis xyz="0 -1 0"/>
  </joint>

  <link name="$(arg ns)/wheel_left_link">
    <visual>
      <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
      <geometry>
        <mesh filename = "package://${package_name}/meshes/rueda_puzzlebot.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
      <geometry>
        <cylinder length="0.008" radius="0.056"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.056" />
      <inertia ixx="0.000035" ixy="0.0" ixz="0.0" iyy="0.00007" iyz="0.0" izz="0.000035" />
    </inertial>
  </link>

  <joint name="$(arg ns)/caster_wheel_joint" type="fixed">
    <parent link="$(arg ns)/base1_link"/>
    <child link="$(arg ns)/caster_wheel_link"/>
    <origin xyz="0.1 0 -0.0125" rpy="0 0 0"/>
  </joint>

  <link name="$(arg ns)/caster_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.0125"/>
      </geometry>
      <material name="black"/>
    </visual>
    
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.0125"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.01"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia 
        ixx="0.000000625" ixy="0" ixz="0" 
        iyy="0.000000625" iyz="0" 
        izz="0.000000625"/>
    </inertial>
  </link>

   <!-- Camara LOGI -->

   <joint name="$(arg ns)/base_camera_logi_joint" type="fixed">
    <parent link="$(arg ns)/base1_link"/>
    <child link="$(arg ns)/base_camera_logi_link"/>
    <origin xyz="-0.1 0 0.0075" rpy="0 0 ${-PI/2}"/>
  </joint>

  <link name="$(arg ns)/base_camera_logi_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.071 0.094 0.005"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.071 0.094 0.005"/>
      </geometry>
    </collision>
  </link>
  
  <joint name="$(arg ns)/logi_camera_joint" type="fixed">
    <parent link="$(arg ns)/base_camera_logi_link"/>
    <child link="$(arg ns)/logi_camera_link"/>
    <origin xyz="0.008 0 0.0025" rpy="0 0 ${-PI/2}"/>
    <axis xyz="0 0 1" />
  </joint>

  <link name="$(arg ns)/logi_camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename = "package://${package_name}/meshes/logi_camera.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="gray3"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.071 0.094 0.0433"/>
      </geometry>
    </collision>
  </link>





  <gazebo reference="$(arg ns)/logi_camera_link">
    <sensor name="camera" type="camera">
      <ignition_frame_id>$(arg ns)/logi_camera_link</ignition_frame_id>
      <optical_frame_id>$(arg ns)/logi_camera_link</optical_frame_id>
      <camera>
        <horizontal_fov>1.229</horizontal_fov>
        <image>
          <width>320</width>
          <height>240</height>
          <format>R8G8B8</format>
        </image>
        <camera_info_topic>$(arg ns)/camera/camera_info</camera_info_topic>
        <clip>
          <near>0.1</near>
          <far>100</far>
        </clip>
        <distortion>
          <k1>0</k1>
          <k2>0</k2>
          <k3>0</k3>
          <p1>0</p1>
          <p2>0</p2>
          <center>0.5 0.5</center>
        </distortion>
      </camera>
      <always_on>1</always_on>
      <update_rate>10</update_rate>
      <visualize>false</visualize>
      <topic>$(arg ns)/camera/image_raw</topic>
      <enable_metrics>true</enable_metrics>
    </sensor>
  </gazebo>

  <!-- Cámara Logi aérea -->
  <joint name="$(arg ns)/logi_camera_joint2" type="fixed">
    <parent link="$(arg ns)/base1_link"/>
    <child link="$(arg ns)/logi_camera_link2"/>
    <origin xyz="0.008 0 2.0" rpy="0 ${PI/2} ${PI/2}"/>
    <axis xyz="0 0 1" />
  </joint>

  <link name="$(arg ns)/logi_camera_link2">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename = "package://${package_name}/meshes/logi_camera.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="gray3"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.071 0.094 0.0433"/>
      </geometry>
    </collision>
  </link>

  <gazebo reference="$(arg ns)/logi_camera_link2">
    <sensor name="camera2" type="camera">
      <ignition_frame_id>$(arg ns)/logi_camera_link2</ignition_frame_id>
      <optical_frame_id>$(arg ns)/logi_camera_link2</optical_frame_id>
      <camera>
        <horizontal_fov>1.229</horizontal_fov>
        <image>
          <width>320</width>
          <height>240</height>
          <format>R8G8B8</format>
        </image>
        <camera_info_topic>$(arg ns)/camera2/camera_info2</camera_info_topic>
        <clip>
          <near>0.1</near>
          <far>100</far>
        </clip>
        <distortion>
          <k1>0</k1>
          <k2>0</k2>
          <k3>0</k3>
          <p1>0</p1>
          <p2>0</p2>
          <center>0.5 0.5</center>
        </distortion>
      </camera>
      <always_on>1</always_on>
      <update_rate>10</update_rate>
      <visualize>false</visualize>
      <topic>$(arg ns)/camera2/image_raw2</topic>
      <enable_metrics>true</enable_metrics>
    </sensor>
  </gazebo>

  <!-- LIDAR -->
  <joint name="$(arg ns)/hokuyo_joint" type="fixed">
    <parent link="$(arg ns)/base3_link"/>
    <child link="$(arg ns)/hokuyo_link" />
    <origin xyz="0.0 0 0.04" rpy="0 0 ${PI}"/>
    <axis xyz="0 0 1" />
  </joint>

  <link name="$(arg ns)/hokuyo_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://${package_name}/meshes/hokuyo.dae"/>
        <material name="black" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.07"/>
      </geometry>
    </collision>
  </link>


  <gazebo reference = "$(arg ns)/hokuyo_link">
    <sensor name='gpu_lidar' type='gpu_lidar'>
      <ignition_frame_id>$(arg ns)/hokuyo_link</ignition_frame_id>
      <update_rate>40</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.1</min>
          <max>0.5</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type> gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <alwaysOn>1</alwaysOn>
      <visualize>true</visualize>
      <topic>$(arg ns)/hokuyo</topic>
    </sensor>
  </gazebo>

   <!-- IMU -->
  <gazebo reference = "$(arg ns)/base_footprint">
    <sensor name = "imu_sensor" type="imu">
      <ignition_frame_id>$(arg ns)/base_footprint</ignition_frame_id>
      <always_on>1</always_on>
      <update_rate>50</update_rate>
      <visualize>false</visualize>
      <topic>$(arg ns)/imu</topic>
      <imu>
        <enable_orientation>0</enable_orientation>
        <angular_velocity>
          <x>
            <noise type = "gaussian">
              <mean>0</mean>
              <stddev>0.009</stddev>
              <bias_mean>0.00075</bias_mean>
              <bias_stddev>0.005</bias_stddev>
              <dynamic_bias_stddev>0.00002</dynamic_bias_stddev>
              <precision>0.00025</precision>
            </noise>
          </x>
          <y>
            <noise type = "gaussian">
              <mean>0</mean>
              <stddev>0.009</stddev>
              <bias_mean>0.00075</bias_mean>
              <bias_stddev>0.005</bias_stddev>
              <dynamic_bias_stddev>0.00002</dynamic_bias_stddev>
              <precision>0.00025</precision>
            </noise>
          </y>
          <z>
            <noise type = "gaussian">
              <mean>0</mean>
              <stddev>0.009</stddev>
              <bias_mean>0.00075</bias_mean>
              <bias_stddev>0.005</bias_stddev>
              <dynamic_bias_stddev>0.00002</dynamic_bias_stddev>
              <precision>0.00025</precision>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type = "gaussian">
              <mean>0</mean>
              <stddev>0.021</stddev>
              <bias_mean>0.05</bias_mean>
              <bias_stddev>0.0075</bias_stddev>
              <dynamic_bias_stddev>0.000375</dynamic_bias_stddev>
              <dynamic_bias_correlation_time>175.0</dynamic_bias_correlation_time>
              <precision>0.005</precision>
            </noise>
          </x>
          <y>
            <noise type = "gaussian">
              <mean>0</mean>
              <stddev>0.021</stddev>
              <bias_mean>0.05</bias_mean>
              <bias_stddev>0.0075</bias_stddev>
              <dynamic_bias_stddev>0.000375</dynamic_bias_stddev>
              <dynamic_bias_correlation_time>175.0</dynamic_bias_correlation_time>
              <precision>0.005</precision>
            </noise>
          </y>
          <z>
            <noise type = "gaussian">
              <mean>0</mean>
              <stddev>0.021</stddev>
              <bias_mean>0.05</bias_mean>
              <bias_stddev>0.0075</bias_stddev>
              <dynamic_bias_stddev>0.000375</dynamic_bias_stddev>
              <dynamic_bias_correlation_time>175.0</dynamic_bias_correlation_time>
              <precision>0.005</precision>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin
      filename="ignition-gazebo-diff-drive-system"
      name="ignition::gazebo::systems::DiffDrive">
      <left_joint>$(arg ns)/wheel_left_joint</left_joint>
      <right_joint>$(arg ns)/wheel_right_joint</right_joint>
      <wheel_separation>${wheelSeparation}</wheel_separation>
      <wheel_radius>${wheelDiameter/2}</wheel_radius>
      <odom_publish_frequency>20</odom_publish_frequency>
      <max_linear_acceleration>2.0</max_linear_acceleration>
      <min_linear_acceleration>-2.0</min_linear_acceleration>
      <max_angular_acceleration>5</max_angular_acceleration>
      <min_angular_acceleration>-5</min_angular_acceleration>
      <max_linear_velocity>1.0</max_linear_velocity>
      <min_linear_velocity>-1.0</min_linear_velocity>
      <max_angular_velocity>5</max_angular_velocity>
      <min_angular_velocity>-5</min_angular_velocity>
    </plugin>

    <plugin
      filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
    </plugin>

  </gazebo>

  <gazebo reference="$(arg ns)/caster_wheel_link">
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
  </gazebo>

</robot>

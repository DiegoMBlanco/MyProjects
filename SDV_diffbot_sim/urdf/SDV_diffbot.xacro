<?xml version="1.0"?>
<robot name="puzzlebot" xmlns:xacro="http://ros.org/wiki/xacro"> 
  <xacro:property name="package_name" value="SDV_diffbot_sim"/>
  <xacro:property name="PI" value="3.14159265"/>
  <xacro:property name="wheelSeparation" value="0.209"/> 
  <xacro:property name="wheelDiameter" value="0.112"/>
  <xacro:property name="wheelThickness" value="0.008"/>
  <xacro:property name="base_elevation" value="0.025"/>

  <xacro:arg name="base_color"    default="0.0 1.0 0.0 1.0"/>
  <xacro:arg name="ns" default="r1"/>
  
  <material name="gray">
    <color rgba="0.4 0.4 0.4 1.0"/>
  </material>

  <material name="gray2">
    <color rgba="0.6 0.6 0.6 1.0"/>
  </material>
  <material name="gray3">
    <color rgba="0.3 0.3 0.3 1.0"/>
  </material>

  <material name="black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>

  <material name="golden">
    <color rgba="1.0 0.4 0.0 1.0"/>
  </material>

  <material name="red">
    <color rgba="1.0 0.0 0.0 1.0"/>
  </material>

  <material name="glass">
    <color rgba="0.1 0.1 0.1 0.8"/>
  </material>

  <material name="white">
    <color rgba="1.0 1.0 1.0 1.0"/>
  </material>

  <link name="$(arg ns)/base_footprint"/>

  <joint name="$(arg ns)/base1_joint" type="fixed">
    <parent link="$(arg ns)/base_footprint"/>
    <child link="$(arg ns)/base1_link"/>
    <origin xyz="0 0 ${wheelDiameter/2-base_elevation}" rpy = "0 0 0"/> <!--0 ${wheelSeparation/2} ${wheelDiameter/2-base_elevation}-->
    <axis xyz="0 0 0"/>
  </joint>

  <link name="$(arg ns)/base1_link">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 ${PI}"/>  <!--0.095 0.0815 0.0-->
      <geometry>
        <mesh filename = "package://${package_name}/meshes/base_SDV_diffbot.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0.01 0 0.0025" rpy="0 0 ${PI/2}"/>
      <geometry>
        <box size="0.175 0.3 0.005"/>
      </geometry>
    </collision>
    <collision> 
      <origin xyz="0.1 0 -0.01" rpy="0 0 0" />
      <geometry>
        <sphere radius="0.01" />
      </geometry>
    </collision>
		<inertial>
      <origin xyz="-0.0550 0 0" rpy="0 0 0"/>
      <mass value="0.485"/>
      <inertia ixx="0.001881" ixy="0.0" ixz="0.0" iyy="0.001133" iyz="0.0" izz="0.002815" />
    </inertial>
  </link>

  <joint name="$(arg ns)/chasis_joint" type="fixed">
    <parent link="$(arg ns)/base1_link"/>
    <child link="$(arg ns)/chasis_link"/>
    <origin xyz="0.017 0.0 0.005" rpy = "0 0 0"/> 
  </joint>

  <link name="$(arg ns)/chasis_link">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 ${PI}"/> 
      <geometry>
        <mesh filename = "package://${package_name}/meshes/chasis_SDV_diffbot.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="glass"/>
    </visual>
  </link>

   <joint name="$(arg ns)/base2_joint" type="fixed">
    <parent link="$(arg ns)/chasis_link"/>
    <child link="$(arg ns)/base2_link"/>
    <origin xyz="-0.017 0.0 0.077" rpy = "0 0 0"/> 
  </joint>

  <link name="$(arg ns)/base2_link">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 ${PI}"/> 
      <geometry>
        <mesh filename = "package://${package_name}/meshes/base2_SDV_diffbot.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 ${PI/2}"/>
      <geometry>
        <box size="0.175 0.3 0.005"/>
      </geometry>
    </collision>
  </link>

  <joint name="$(arg ns)/left_wheel_box_joint" type="fixed">
    <parent link="$(arg ns)/base1_link"/>
    <child link="$(arg ns)/left_wheel_box_link"/>
    <origin xyz="0.075 0.065 0.02" rpy = "0 0 0"/>
    <axis xyz="0 0 0"/>
  </joint>

  <link name="$(arg ns)/left_wheel_box_link">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>  
      <geometry>
        <box size="0.03 0.03 0.03"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0.0 0 0.0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.03 0.03"/>
      </geometry>
    </collision>
  </link>

  <joint name="$(arg ns)/right_wheel_box_joint" type="fixed">
    <parent link="$(arg ns)/base1_link"/>
    <child link="$(arg ns)/right_wheel_box_link"/>
    <origin xyz="0.075 -0.065 0.02" rpy = "0 0 0"/>
    <axis xyz="0 0 0"/>
  </joint>

  <link name="$(arg ns)/right_wheel_box_link">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>  
      <geometry>
        <box size="0.03 0.03 0.03"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0.0 0 0.0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.03 0.03"/>
      </geometry>
    </collision>
  </link>

  <joint name="$(arg ns)/left_wheel_cylinder_joint" type="fixed">
    <parent link="$(arg ns)/left_wheel_box_link"/>
    <child link="$(arg ns)/left_wheel_cylinder_link"/>
    <origin xyz="0.0 0.0195 0.0" rpy = "${PI/2} 0 0"/>
    <axis xyz="0 0 0"/>
  </joint>

  <link name="$(arg ns)/left_wheel_cylinder_link">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>  
      <geometry>
        <cylinder length="0.009" radius="0.005"/>
      </geometry>
      <material name="golden"/>
    </visual>
    <collision>
      <origin xyz="0.0 0 0.0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.009" radius="0.005"/>
      </geometry>
    </collision>
  </link>

  <joint name="$(arg ns)/right_wheel_cylinder_joint" type="fixed">
    <parent link="$(arg ns)/right_wheel_box_link"/>
    <child link="$(arg ns)/right_wheel_cylinder_link"/>
    <origin xyz="0.0 -0.0195 0.0" rpy = "${PI/2} 0 0"/>
    <axis xyz="0 0 0"/>
  </joint>

  <link name="$(arg ns)/right_wheel_cylinder_link">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>  
      <geometry>
        <cylinder length="0.009" radius="0.005"/>
      </geometry>
      <material name="golden"/>
    </visual>
    <collision>
      <origin xyz="0.0 0 0.0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.009" radius="0.005"/>
      </geometry>
    </collision>
  </link>

  <joint name="$(arg ns)/left_wheel_joint" type="continuous">
    <parent link="$(arg ns)/left_wheel_cylinder_link"/>
    <child link="$(arg ns)/left_wheel_link"/>
    <origin xyz="0.0 0.0 -0.0125" rpy = "0 0 0"/>
    <axis xyz="0 0 -1"/>
  </joint>

  <link name="$(arg ns)/left_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>  
      <geometry>
        <mesh filename = "package://${package_name}/meshes/rueda_puzzlebot.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.004" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.008" radius="0.056"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="5" />
      <inertia ixx="0.0135417" ixy="0.0" ixz="0.0"  iyy="0.0135417" iyz="0.0"  izz="0.025" />
    </inertial>
  </link>

  <joint name="$(arg ns)/right_wheel_joint" type="continuous">
    <parent link="$(arg ns)/right_wheel_cylinder_link"/>
    <child link="$(arg ns)/right_wheel_link"/>
    <origin xyz="0.0 0.0 0.0045" rpy = "0 0 0"/>
    <axis xyz="0 0 -1"/>
  </joint>

  <link name="$(arg ns)/right_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>  
      <geometry>
        <mesh filename = "package://${package_name}/meshes/rueda_puzzlebot.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.004" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.008" radius="0.056"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" />
      <mass value="5" />
      <inertia ixx="0.0135417" ixy="0.0" ixz="0.0"  iyy="0.0135417" iyz="0.0"  izz="0.025" />
    </inertial>
  </link>


  <joint name="$(arg ns)/caster_wheel_joint" type="fixed">
    <parent link="$(arg ns)/base1_link"/>
    <child link="$(arg ns)/caster_wheel_link"/>
    <origin xyz="-0.145 0 -0.018" rpy="0 0 0"/>
  </joint>

  <link name="$(arg ns)/caster_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.018"/>
      </geometry>
      <material name="black"/>
    </visual>
    
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.018"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.01"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia 
        ixx="0.000000625" ixy="0" ixz="0" 
        iyy="0.000000625" iyz="0" 
        izz="0.000000625"/>
    </inertial>
  </link>


  <joint name="$(arg ns)/rubik_joint" type="fixed">
      <parent link="$(arg ns)/base1_link"/>
      <child link="$(arg ns)/rubik_link"/>
      <origin xyz="-0.05 0 0.005" rpy = "0 0 ${PI/2}"/>
      <axis xyz="0 0 0"/>
    </joint>

    <link name="$(arg ns)/rubik_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/> 
        <geometry>
          <mesh filename = "package://${package_name}/meshes/rubik.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="gray2"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.1 0.07 0.002"/>
        </geometry>
      </collision>
    </link>

    <joint name="$(arg ns)/base_rubik_joint" type="fixed">
      <parent link="$(arg ns)/base1_link"/>
      <child link="$(arg ns)/base_rubik_link"/>
      <origin xyz="-0.05 0 0.005" rpy = "0 0 ${PI/2}"/>
      <axis xyz="0 0 0"/>
    </joint>

    <link name="$(arg ns)/base_rubik_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/> 
        <geometry>
          <box size="0.1 0.075 0.0055"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.1 0.075 0.0055"/>
        </geometry>
      </collision>
    </link>


    <!--IMU-->
    <joint name="$(arg ns)/IMU_base_joint" type="fixed">
      <parent link="$(arg ns)/base1_link"/>
      <child link="$(arg ns)/IMU_base_link"/>
      <origin xyz="0.03 0 0.005" rpy = "0 0 ${PI/2}"/>
      <axis xyz="0 0 0"/>
    </joint>

    <link name="$(arg ns)/IMU_base_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/> 
        <geometry>
          <box size="0.03 0.02 0.0055"/>
        </geometry>
        <material name="red"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="0.03 0.02 0.0055"/>
        </geometry>
      </collision>
    </link>

    <gazebo reference = "$(arg ns)/IMU_base_link">
    <sensor name = "imu_sensor" type="imu">
      <ignition_frame_id>$(arg ns)/IMU_base_link</ignition_frame_id>
      <always_on>1</always_on>
      <update_rate>50</update_rate>
      <visualize>false</visualize>
      <topic>$(arg ns)/imu</topic>
      <imu>
        <enable_orientation>0</enable_orientation>
        <angular_velocity>
          <x>
            <noise type = "gaussian">
              <mean>0</mean>
              <stddev>0.009</stddev>
              <bias_mean>0.00075</bias_mean>
              <bias_stddev>0.005</bias_stddev>
              <dynamic_bias_stddev>0.00002</dynamic_bias_stddev>
              <precision>0.00025</precision>
            </noise>
          </x>
          <y>
            <noise type = "gaussian">
              <mean>0</mean>
              <stddev>0.009</stddev>
              <bias_mean>0.00075</bias_mean>
              <bias_stddev>0.005</bias_stddev>
              <dynamic_bias_stddev>0.00002</dynamic_bias_stddev>
              <precision>0.00025</precision>
            </noise>
          </y>
          <z>
            <noise type = "gaussian">
              <mean>0</mean>
              <stddev>0.009</stddev>
              <bias_mean>0.00075</bias_mean>
              <bias_stddev>0.005</bias_stddev>
              <dynamic_bias_stddev>0.00002</dynamic_bias_stddev>
              <precision>0.00025</precision>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type = "gaussian">
              <mean>0</mean>
              <stddev>0.021</stddev>
              <bias_mean>0.05</bias_mean>
              <bias_stddev>0.0075</bias_stddev>
              <dynamic_bias_stddev>0.000375</dynamic_bias_stddev>
              <dynamic_bias_correlation_time>175.0</dynamic_bias_correlation_time>
              <precision>0.005</precision>
            </noise>
          </x>
          <y>
            <noise type = "gaussian">
              <mean>0</mean>
              <stddev>0.021</stddev>
              <bias_mean>0.05</bias_mean>
              <bias_stddev>0.0075</bias_stddev>
              <dynamic_bias_stddev>0.000375</dynamic_bias_stddev>
              <dynamic_bias_correlation_time>175.0</dynamic_bias_correlation_time>
              <precision>0.005</precision>
            </noise>
          </y>
          <z>
            <noise type = "gaussian">
              <mean>0</mean>
              <stddev>0.021</stddev>
              <bias_mean>0.05</bias_mean>
              <bias_stddev>0.0075</bias_stddev>
              <dynamic_bias_stddev>0.000375</dynamic_bias_stddev>
              <dynamic_bias_correlation_time>175.0</dynamic_bias_correlation_time>
              <precision>0.005</precision>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>


<!--Camera-->
<joint name="$(arg ns)/zed_camera_joint" type="fixed">
    <parent link="$(arg ns)/base1_link"/>
    <child link="$(arg ns)/zed_camera_link"/>
    <origin xyz="0.195 0.0 0.01" rpy="0 0 0"/>
    <axis xyz="0 0 1" />
  </joint>

  <link name="$(arg ns)/zed_camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <!--<mesh filename = "package://${package_name}/meshes/logi_camera.stl" scale="0.001 0.001 0.001"/>-->
        <box size="0.01 0.01 0.01"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <!--<box size="0.071 0.094 0.0433"/>-->
        <box size="0.01 0.01 0.01"/>
      </geometry>
    </collision>
     <inertial>
      <mass value="1e-5" />
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6" />
    </inertial>
  </link>

  <gazebo reference="$(arg ns)/zed_camera_link">
     <sensor name="rgbd_camera" type="rgbd_camera">
      <ignition_frame_id>$(arg ns)/zed_camera_link</ignition_frame_id>
      <camera name="zed_camera">
        <horizontal_fov>0.8709216071359963</horizontal_fov>
        <distortion>
          <k1>0.0</k1>
          <k2>0.0</k2>
          <k3>0.0</k3>
          <p1>0.0</p1>
          <p2>0.0</p2>
          <center>0.5 0.5</center>
        </distortion>
        <image>
          <width>640</width>
          <height>480</height>
          <format>B8G8R8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>300</far>
        </clip>
        <depth_camera>
          <clip>
            <near>0.1</near>
            <far>20</far>
          </clip>
        </depth_camera>
        <noise>
          <type>gaussian</type>
          <mean>0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
      <always_on>1</always_on>
      <update_rate>15</update_rate>
      <visualize>0</visualize>
      <topic>$(arg ns)/zed_camera</topic>
    </sensor>
  </gazebo>


<!-- LIDAR -->
  <joint name="$(arg ns)/hokuyo_joint" type="fixed">
    <parent link="$(arg ns)/base2_link"/>
    <child link="$(arg ns)/hokuyo_link" />
    <origin xyz="0.0975 0 0.055" rpy="0 0 0"/>
    <axis xyz="0 0 1" />
  </joint>

  <link name="$(arg ns)/hokuyo_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://${package_name}/meshes/hokuyo.dae"/>
        <material name="black" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.07"/>
      </geometry>
    </collision>
  </link>


  <gazebo reference = "$(arg ns)/hokuyo_link">
    <sensor name='gpu_lidar' type='gpu_lidar'>
      <ignition_frame_id>$(arg ns)/hokuyo_link</ignition_frame_id>
      <update_rate>40</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>1081</samples>
            <resolution>1</resolution>
            <min_angle>-2.3561944902</min_angle>
            <max_angle>2.3561944902</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.1</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type> gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <alwaysOn>1</alwaysOn>
      <visualize>true</visualize>
      <topic>$(arg ns)/hokuyo</topic>
    </sensor>
  </gazebo>







    <gazebo>
			<plugin
				filename="ignition-gazebo-diff-drive-system"
				name="ignition::gazebo::systems::DiffDrive">
				<left_joint>$(arg ns)/left_wheel_joint</left_joint>
				<right_joint>$(arg ns)/right_wheel_joint</right_joint>
				<wheel_separation>${wheelSeparation}</wheel_separation>
				<wheel_radius>${wheelDiameter/2}</wheel_radius>
				<odom_publish_frequency>20</odom_publish_frequency>
				<max_linear_acceleration>2.0</max_linear_acceleration>
				<min_linear_acceleration>-2.0</min_linear_acceleration>
				<max_angular_acceleration>5</max_angular_acceleration>
				<min_angular_acceleration>-5</min_angular_acceleration>
				<max_linear_velocity>1.0</max_linear_velocity>
				<min_linear_velocity>-1.0</min_linear_velocity>
				<max_angular_velocity>5</max_angular_velocity>
				<min_angular_velocity>-5</min_angular_velocity>
			</plugin>

			<plugin
				filename="gz-sim-joint-state-publisher-system"
				name="gz::sim::systems::JointStatePublisher">
			</plugin>
    </gazebo>

</robot>